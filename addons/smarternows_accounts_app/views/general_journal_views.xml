<odoo>
    <record id="view_general_journal_form" model="ir.ui.view">
        <field name="name">general.journal.form</field>
        <field name="model">general.journal</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="date"/>
                        <field name="journal_id"/>
                    </group>
                    <notebook>
                        <page string="Lines">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="account_id"/>
                                    <field name="debit"/>
                                    <field name="credit"/>
                                    <field name="partner_id"/>
                                    <field name="description"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_button_box" name="button_box">
                    <button name="action_view_move" type="object"
                            class="oe_stat_button" icon="fa-book">
                        <field name="move_id" widget="statinfo" string="Ledger Entry"/>
                    </button>
                </div>
                <footer>
                    <button name="action_post" type="object" string="Post to Ledger" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
