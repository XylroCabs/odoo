<odoo>
    <record id="view_general_journal_tree" model="ir.ui.view">
        <field name="name">general.journal.tree</field>
        <field name="model">general.journal</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="date"/>
                <field name="journal_id"/>
            </tree>
        </field>
    </record>

    <record id="view_general_journal_form" model="ir.ui.view">
        <field name="name">general.journal.form</field>
        <field name="model">general.journal</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="date"/>
                        <field name="journal_id"/>
                    </group>
                    <notebook>
                        <page string="Lines">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="account_id"/>
                                    <field name="debit"/>
                                    <field name="credit"/>
                                    <field name="partner_id"/>
                                    <field name="description"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_general_journal" model="ir.actions.act_window">
        <field name="name">General Journal</field>
        <field name="res_model">general.journal</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_general_journal" name="General Journal"
              parent="menu_account_merge_root" action="action_general_journal"/>
</odoo>
