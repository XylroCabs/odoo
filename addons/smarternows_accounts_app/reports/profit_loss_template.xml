<odoo>
    <template id="profit_loss_template">
        <t t-call="web.html_container">
            <t t-set="date_from" t-value="context.get('date_from')"/>
            <t t-set="date_to" t-value="context.get('date_to')"/>
            <div class="page">
                <h2>Profit & Loss Report</h2>
                <p>Period: <t t-esc="date_from"/> to <t t-esc="date_to"/></p>
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Transaction</th>
                            <th>Date</th>
                            <th>Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="docs" t-as="doc">
                            <tr>
                                <td><t t-esc="doc.name"/></td>
                                <td><t t-esc="doc.date"/></td>
                                <td><t t-esc="doc.amount"/></td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>
        </t>
    </template>
</odoo>
