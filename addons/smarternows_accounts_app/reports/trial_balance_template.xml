<odoo>
    <template id="trial_balance_template">
        <t t-call="web.html_container">
            <t t-set="date_from" t-value="context.get('date_from')"/>
            <t t-set="date_to" t-value="context.get('date_to')"/>
            <div class="page">
                <h2>Trial Balance</h2>
                <p>Period: <t t-esc="date_from"/> to <t t-esc="date_to"/></p>
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Account</th>
                            <th>Debit</th>
                            <th>Credit</th>
                            <th>Balance</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="docs" t-as="line">
                            <tr>
                                <td><t t-esc="line.account_id.display_name"/></td>
                                <td><t t-esc="line.debit"/></td>
                                <td><t t-esc="line.credit"/></td>
                                <td><t t-esc="line.balance"/></td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>
        </t>
    </template>
</odoo>
