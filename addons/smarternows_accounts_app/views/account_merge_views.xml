<odoo>
    <record id="view_account_merge_tree" model="ir.ui.view">
        <field name="name">account.merge.tree</field>
        <field name="model">account.merge</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="date"/>
                <field name="partner_id"/>
                <field name="transaction_type"/>
                <field name="amount"/>
            </tree>
        </field>
    </record>

    <record id="view_account_merge_form" model="ir.ui.view">
        <field name="name">account.merge.form</field>
        <field name="model">account.merge</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="date"/>
                        <field name="partner_id"/>
                        <field name="transaction_type"/>
                        <field name="amount"/>
                        <field name="currency_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_account_merge" model="ir.actions.act_window">
        <field name="name">Unified Transactions</field>
        <field name="res_model">account.merge</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
