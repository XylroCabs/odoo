<odoo>
    <record id="view_bank_reconciliation_wizard_form" model="ir.ui.view">
        <field name="name">bank.reconciliation.wizard.form</field>
        <field name="model">bank.reconciliation.wizard</field>
        <field name="arch" type="xml">
            <form string="Bank Reconciliation">
                <sheet>
                    <group>
                        <field name="statement_id"/>
                        <field name="journal_id"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_reconcile" type="object" string="Reconcile" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_bank_reconciliation_wizard" model="ir.actions.act_window">
        <field name="name">Bank Reconciliation</field>
        <field name="res_model">bank.reconciliation.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_bank_reconciliation" name="Bank Reconciliation"
              parent="menu_account_merge_root" action="action_bank_reconciliation_wizard"/>
</odoo>
