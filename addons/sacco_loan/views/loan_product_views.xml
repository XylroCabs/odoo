<odoo>
    <!-- Loan Product Action -->
    <record id="action_sacco_products" model="ir.actions.act_window">
        <field name="name">Loan Products</field>
        <field name="res_model">sacco.loan.product</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Loan Product Tree View -->
    <record id="view_sacco_loan_product_tree" model="ir.ui.view">
        <field name="name">sacco.loan.product.tree</field>
        <field name="model">sacco.loan.product</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="code"/>
                <field name="journal_id"/>
                <field name="receivable_account_id"/>
                <field name="interest_income_account_id"/>
            </tree>
        </field>
    </record>

    <!-- Loan Product Form View -->
    <record id="view_sacco_loan_product_form" model="ir.ui.view">
        <field name="name">sacco.loan.product.form</field>
        <field name="model">sacco.loan.product</field>
        <field name="arch" type="xml">
            <form string="Loan Product">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="journal_id"/>
                        <field name="receivable_account_id"/>
                        <field name="interest_income_account_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
