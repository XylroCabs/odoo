<odoo>
    <!-- Loan Action -->
    <record id="action_sacco_loans" model="ir.actions.act_window">
        <field name="name">Loans</field>
        <field name="res_model">sacco.loan</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Loan Tree View -->
    <record id="view_sacco_loan_tree" model="ir.ui.view">
        <field name="name">sacco.loan.tree</field>
        <field name="model">sacco.loan</field>
        <field name="arch" type="xml">
            <tree>
                <field name="member_id"/>
                <field name="loan_product_id"/>
                <field name="amount"/>
                <field name="term_months"/>
                <field name="interest_rate"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <!-- Loan Form View -->
    <record id="view_sacco_loan_form" model="ir.ui.view">
        <field name="name">sacco.loan.form</field>
        <field name="model">sacco.loan</field>
        <field name="arch" type="xml">
            <form string="Loan">
                <sheet>
                    <group>
                        <field name="member_id"/>
                        <field name="loan_product_id"/>
                        <field name="amount"/>
                        <field name="term_months"/>
                        <field name="interest_rate"/>
                        <field name="state" readonly="1"/>
                        <field name="journal_entry_id" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Repayment Schedule">
                            <field name="schedule_ids">
                                <tree editable="bottom">
                                    <field name="due_date"/>
                                    <field name="principal_amount"/>
                                    <field name="interest_amount"/>
                                    <field name="total_amount"/>
                                    <field name="paid"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button name="action_disburse" type="object" string="Disburse Loan" states="approved" class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
